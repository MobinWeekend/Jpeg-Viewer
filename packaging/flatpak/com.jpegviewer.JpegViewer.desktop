[Desktop Entry]
Name=JPEG Viewer
GenericName=Image Viewer
Comment=Fast and lightweight GPU-accelerated image viewer
Exec=jpeg_viewer %F
Icon=com.jpegviewer.JpegViewer
Terminal=false
Type=Application
Categories=Graphics;Viewer;Photography;
MimeType=image/bmp;image/gif;image/jpeg;image/png;image/tiff;image/webp;image/avif;image/heic;image/heif;image/jxl;image/svg+xml;image/x-tga;image/x-dds;image/x-exr;
Keywords=image;viewer;photo;picture;jpeg;png;gif;
StartupNotify=true
StartupWMClass=jpeg_viewer

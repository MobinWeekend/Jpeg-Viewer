# Maintainer: MobinWeekend
pkgname=jpeg-viewer
pkgver=0.1.13
pkgrel=1
_release_tag="v0.1.13"
pkgdesc='GPU-accelerated desktop image viewer written in Rust'
arch=('x86_64' 'aarch64')
url='https://github.com/MobinWeekend/Jpeg-Viewer'
license=('GPL-3.0-only')
depends=('gcc-libs' 'glibc' 'libx11' 'libxkbcommon' 'wayland' 'mesa' 'dbus' 'zstd' 'unrar')
makedepends=('rust' 'cargo' 'python' 'pkgconf' 'zstd' 'unrar')
options=(!debug !lto)
# In Actions, build the exact commit selected in the workflow UI. For local
# package builds, retain the normal release-tag source behavior.
if [[ -n "${JPEG_VIEWER_SOURCE_COMMIT:-}" ]]; then
  source=("jpeg-viewer::git+https://github.com/MobinWeekend/Jpeg-Viewer.git#commit=${JPEG_VIEWER_SOURCE_COMMIT}")
else
  source=("jpeg-viewer::git+https://github.com/MobinWeekend/Jpeg-Viewer.git#tag=${_release_tag}")
fi
sha256sums=('SKIP')

prepare() {
  cd "$srcdir/jpeg-viewer"
  python scripts/prepare_release.py "${_release_tag}"
}

build() {
  cd "$srcdir/jpeg-viewer"

  # Arch's global Rust flags have caused native static libraries to remain
  # unresolved in this application build. Use rustc/Cargo defaults here.
  unset RUSTFLAGS CARGO_ENCODED_RUSTFLAGS CARGO_BUILD_RUSTFLAGS
  unset CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS
  unset CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_RUSTFLAGS

  # Prefer the system zstd library when the distribution provides it.
  export ZSTD_SYS_USE_PKG_CONFIG=1

  cargo build --release --locked
}

package() {
  cd "$srcdir/jpeg-viewer"

  install -Dm755 target/release/jpeg_viewer "$pkgdir/usr/bin/jpeg_viewer"
  install -Dm644 packaging/linux/com.jpegviewer.JpegViewer.desktop \
    "$pkgdir/usr/share/applications/com.jpegviewer.JpegViewer.desktop"
  install -Dm644 packaging/icons/512x512/com.jpegviewer.JpegViewer.png \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/com.jpegviewer.JpegViewer.png"
  install -Dm644 packaging/linux/com.jpegviewer.JpegViewer.metainfo.xml \
    "$pkgdir/usr/share/metainfo/com.jpegviewer.JpegViewer.metainfo.xml"
  install -Dm644 packaging/linux/jpeg-viewer-queue.xml \
    "$pkgdir/usr/share/mime/packages/jpeg-viewer-queue.xml"
  install -Dm644 LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

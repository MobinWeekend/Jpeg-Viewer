<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>com.jpegviewer.JpegViewer</id>

    <name>JPEG Viewer</name>
    <summary>Fast and lightweight GPU-accelerated image viewer</summary>

    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0-only</project_license>

    <developer id="com.jpegviewer">
        <name>MobinWeekend</name>
    </developer>

    <description>
        <p>
            JPEG Viewer is a fast, lightweight GPU-accelerated image viewer
            written in Rust. It is designed to make browsing large image
            collections quick and effortless.
        </p>

        <p>
            JPEG Viewer supports common image formats as well as modern
            formats such as AVIF, HEIC, JPEG XL, and SVG.
        </p>

        <p>
            Images stored inside ZIP, 7-Zip, and RAR archives can be viewed
            without extracting them.
        </p>

        <ul>
            <li>GPU-accelerated rendering</li>
            <li>GIF animation and playback controls</li>
            <li>Slideshow mode</li>
            <li>Background image preloading</li>
            <li>Configurable image caching</li>
            <li>Virtual texturing for extremely large images</li>
            <li>ZIP, 7z, and RAR archive support</li>
            <li>Fullscreen viewing</li>
            <li>Drag and drop support</li>
            <li>File type detection and extension correction</li>
        </ul>
    </description>

    <launchable type="desktop-id">
        com.jpegviewer.JpegViewer.desktop
    </launchable>

    <provides>
        <binary>jpeg_viewer</binary>
    </provides>

    <url type="homepage">https://github.com/MobinWeekend/Jpeg-Viewer</url>
